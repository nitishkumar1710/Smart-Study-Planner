PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/study-planner
ML_URL=http://127.0.0.1:8000
# Optional: enables LLM-written plan explanations (falls back to rule-based text)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Study window (local hours) and max sessions per day
DAY_START=7
DAY_END=23
MAX_SESSIONS_PER_DAY=4
